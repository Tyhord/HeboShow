# Vorlage. Kopieren nach .env und anpassen. Nach dem Ändern die App neu starten.
# This code has been fully generated by an AI.
#
# Kommentare nur am Zeilenanfang, sonst landen sie im Wert.
# Details zu jedem Wert: requirements/11-konfiguration.md


# ============================================================
# Kamera und Anzeige
# ============================================================

# Zahl = lokale Kamera, sonst rtsp://, http://, VDO.Ninja-Link (https://vdo.ninja/?view=…)
# oder Pfad zu einer Videodatei
HEBOCON_CAMERA=0
HEBOCON_CAMERA_WIDTH=1280
HEBOCON_CAMERA_HEIGHT=720

HEBOCON_PORT=8765
# Leer = Netzwerkadapter beim Start auswählen (Wahl wird gemerkt).
# Feste IP = nur diese Adresse, 0.0.0.0 = alle Netzwerke, 127.0.0.1 = nur dieser Rechner
HEBOCON_HOST=
# UDP-Port, über den Clients den Server automatisch finden
HEBOCON_DISCOVERY_PORT=8766
# Passwort für die Moderation; bleibt auf dem Server
HEBOCON_MOD_PASSWORD=admin
HEBOCON_JPEG_QUALITY=80
HEBOCON_STREAM_MAX_WIDTH=1280
# Dauer des Intro-Videos vor jedem Kampf in Sekunden, 0 = ohne Intro
HEBOCON_INTRO_S=7.5


# ============================================================
# Modell und Erkennung
# ============================================================

HEBOCON_MODEL_ID=yonigozlan/EdgeTAM-hf
# 0 = Torch entscheidet selbst
HEBOCON_TORCH_THREADS=0
# true: EdgeTAM verfeinert die Maske bei der Registrierung und prüft nebenher die Identitäten.
# Lohnt sich nur mit GPU; das Tracking selbst läuft immer ohne Modell.
HEBOCON_SEGMENT_ENABLED=false
# Hintergrund im Modellbild weiß; false, wenn Roboter die Farbe des Arenabodens haben.
HEBOCON_WHITE_BACKGROUND=true

# ============================================================
# KI-Clients (laufen auf eigenen PCs, siehe hebo-client)
# ============================================================

# So lange steht eine Sprechblase auf der Bühne
HEBOCON_SAY_S=4

# ============================================================
# Spielregeln (Entfernungen in Arena-Einheiten)
# Im Reiter "Balancing" geänderte Werte stehen in data/balancing.json
# und haben Vorrang vor dieser Datei.
# ============================================================

HEBOCON_START_HP=100
HEBOCON_RINGOUT_HP_PER_S=5
HEBOCON_RINGOUT_GRACE_S=0.5

HEBOCON_COLLISION_DAMAGE=10
HEBOCON_COLLISION_EQUAL_DAMAGE=5
HEBOCON_COLLISION_EQUAL_RATIO=0.25
HEBOCON_COLLISION_MIN_SPEED=80
HEBOCON_COLLISION_COOLDOWN_S=1

HEBOCON_OBSTACLE_DAMAGE=30
HEBOCON_OBSTACLE_LIFETIME_S=8
HEBOCON_OBSTACLE_ARMING_S=1
HEBOCON_OBSTACLE_RADIUS=60

HEBOCON_POWERUP_HEAL=25
HEBOCON_POWERUP_LIFETIME_S=10
HEBOCON_POWERUP_RADIUS=45

# Laser-Ulti: einmal pro Kampf, bereit nach so viel erlittenem Schaden
HEBOCON_ULTI_DAMAGE=25
HEBOCON_ULTI_CHARGE_HP=50
HEBOCON_ULTI_AIM_S=1.2
HEBOCON_ULTI_WIDTH=30

# Arena schrumpfen: Restfläche als Anteil (0.1-1) und Dauer in Sekunden
HEBOCON_SHRINK_MIN_AREA=0.5
HEBOCON_SHRINK_DURATION_S=30
