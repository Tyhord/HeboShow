@echo off
REM This code has been fully generated by an AI.
REM Startet den Hebocon-Server. Zusaetzliche Argumente gehen an den Server, z.B. start.bat --camera 1
setlocal
cd /d "%~dp0"
title Hebocon Server

REM Beim ersten Start fehlt das .venv; dann einmalig alle Pakete installieren.
if not exist ".venv\Scripts\python.exe" (
    echo Erster Start: Pakete werden installiert, das dauert ein paar Minuten ...
    python -m uv --version >nul 2>&1
    if errorlevel 1 python -m pip install --user uv
    python -m uv sync
    if errorlevel 1 (
        echo.
        echo Installation fehlgeschlagen. Ist Python 3.12 installiert und im PATH?
        pause
        exit /b 1
    )
)

".venv\Scripts\python.exe" -m hebocon %*

REM Bei einem Absturz offen bleiben, damit die Fehlermeldung lesbar ist.
if errorlevel 1 pause
