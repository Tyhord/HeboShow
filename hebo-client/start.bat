@echo off
REM This code has been fully generated by an AI.
REM Startet einen Hebocon-Client. Optional: start.bat --server 192.168.0.10
setlocal
cd /d "%~dp0"
title Hebocon Client

REM Beim ersten Start fehlt das .venv; dann einmalig pywebview installieren.
".venv\Scripts\python.exe" -c "import webview" >nul 2>&1
if errorlevel 1 (
    echo Erster Start: Pakete werden installiert ...
    python -m uv --version >nul 2>&1
    if errorlevel 1 python -m pip install --user uv
    python -m uv sync
    if errorlevel 1 (
        echo.
        echo Installation fehlgeschlagen. Ist Python 3.12 installiert und im PATH?
        pause
        exit /b 1
    )
)

".venv\Scripts\python.exe" client.py %*

REM Bei einem Fehler offen bleiben, damit die Meldung lesbar ist.
if errorlevel 1 pause